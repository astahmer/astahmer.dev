{
  "name": "astro-template-portfolio",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#/styled-system/*": "./styled-system/*"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "pnpm panda codegen --clean && MODE=prod pnpm panda",
    "build": "pnpm prebuild && astro build",
    "preview": "astro preview",
    "check": "astro-check",
    "astro": "astro",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "viz": "MODE=viz pnpm build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.1.0",
    "@astrojs/mdx": "5.0.3",
    "@astrojs/preact": "5.1.1",
    "@astrojs/sitemap": "3.7.2",
    "@fontsource-variable/familjen-grotesk": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.9",
    "@vercel/og": "0.11.1",
    "astro": "6.1.7",
    "astro-compress": "2.4.1",
    "astro-compressor": "1.3.0",
    "astro-expressive-code": "0.41.7",
    "astro-robots-txt": "1.0.0",
    "astro-seo": "1.1.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-select": "6.0.4",
    "hast-util-to-string": "3.0.1",
    "hastscript": "9.0.1",
    "preact": "10.29.1",
    "rehype": "13.0.2",
    "rehype-add-classes": "1.0.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "remark-toc": "9.0.0",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@pandacss/dev": "1.9.1",
    "@types/hast": "3.0.4",
    "oxfmt": "0.45.0",
    "oxlint": "1.60.0",
    "pandacss-preset-typography": "0.1.6",
    "rollup-plugin-visualizer": "7.0.1",
    "source-map-explorer": "2.5.3",
    "typescript": "5.9.3"
  }
}
