---
import ProjectCard from '@/components/project-card'
import SocialLinks from '@/components/social-links'
import Layout from '@/layouts/layout.astro'
import { getCollection } from 'astro:content'

import { css } from '#/styled-system/css'
import PostSection from '@/components/post-section'
import { presentation } from '@/data/presentation'
import { projects } from '@/data/projects'

const articles = (await getCollection('articles', (entry) => entry.data.isPublish)).toSorted(
  (first, second) => second.data.publishedAt.getTime() - first.data.publishedAt.getTime(),
)
---

<Layout title={presentation.name} description={presentation.intro}>
  <main class={css({ display: 'grid', gap: '12' })}>
    <section
      class={css({
        display: 'grid',
        gap: '8',
        lg: { gridTemplateColumns: 'minmax(0, 1.45fr) minmax(20rem, 0.82fr)', alignItems: 'start' },
      })}
    >
      <div class={css({ display: 'grid', gap: '5' })}>
        <p class='section-kicker'>Opinionated • Trustworthy • Curious</p>
        <h1 class='hero-title'>{presentation.title}</h1>
        <p class='lede'>{presentation.intro}</p>
        <SocialLinks />
      </div>

      <aside class='surface-note'>
        <div class={css({ display: 'grid', gap: '4' })}>
          <p class='section-kicker'>Now</p>
          <p class={css({ margin: '0', lineHeight: '1.65', color: 'var(--ink-muted)' })}>{presentation.availability}</p>
          <div class={css({ display: 'grid', gap: '3', pt: '3', borderTop: '1px solid var(--line)' })}>
            <p class={css({ margin: '0', fontFamily: 'var(--font-display)', fontSize: '0.76rem', letterSpacing: '0.16em', textTransform: 'uppercase', color: 'var(--ink-soft)' })}>
              Based in {presentation.location}
            </p>
            <ul
              role='list'
              class={css({ display: 'grid', gap: '3', p: '0', m: '0', listStyle: 'none' })}
            >
              {presentation.currentInterests.map((item) => (
                <li class={css({ display: 'grid', gridTemplateColumns: 'auto 1fr', gap: '2.5', alignItems: 'start' })}>
                  <span class={css({ color: 'var(--accent-strong)', lineHeight: '1.5' })}>•</span>
                  <span class={css({ color: 'var(--ink-muted)', lineHeight: '1.6' })}>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </section>

    <section
      class={css({
        display: 'grid',
        gap: '5',
        lg: { gridTemplateColumns: 'repeat(3, minmax(0, 1fr))' },
      })}
    >
      {presentation.focusAreas.map((area, index) => (
        <article class={css({ display: 'grid', gap: '3', pt: '4', borderTop: '1px solid var(--line)' })}>
          <span
            class={css({
              fontFamily: 'var(--font-display)',
              fontSize: '0.72rem',
              fontWeight: '620',
              letterSpacing: '0.16em',
              textTransform: 'uppercase',
              color: 'var(--ink-soft)',
            })}
          >
            {`0${index + 1}`}
          </span>
          <p class={css({ margin: '0', fontSize: '1.02rem', lineHeight: '1.62', color: 'var(--ink-muted)' })}>{area}</p>
        </article>
      ))}
    </section>

    <section class={css({ display: 'grid', gap: '5' })}>
      <header class={css({ display: 'grid', gap: '2' })}>
        <p class='section-kicker'>Selected work</p>
        <h2 class='section-heading'>A few things worth opening in a new tab.</h2>
        <p class='section-copy'>
          Mostly open source, mostly TypeScript, usually sitting somewhere between product needs and tooling weirdness.
        </p>
      </header>
      <section class={css({ display: 'grid' })}>
        {projects.length !== 0 && projects.map((project, index) => <ProjectCard {...project} index={index + 1} />)}
      </section>
    </section>

    <PostSection
      articles={articles.slice(0, 4)}
      title='Recent writing'
      intro='Short notes and longer pieces around styling systems, product architecture, tooling, and the occasional strong opinion.'
      showArchiveLink={articles.length > 4}
    />

    <section
      class={css({
        display: 'grid',
        gap: '6',
        pt: '4',
        borderTop: '1px solid var(--line)',
        lg: { gridTemplateColumns: 'minmax(0, 0.75fr) minmax(0, 1.25fr)' },
      })}
    >
      <div class={css({ display: 'grid', gap: '2', alignContent: 'start' })}>
        <p class='section-kicker'>Working biases</p>
        <h2 class='section-heading'>The part where the opinions leak through.</h2>
      </div>
      <ol role='list' class={css({ display: 'grid', gap: '5', p: '0', m: '0', listStyle: 'none' })}>
        {presentation.principles.map((item, index) => (
          <li
            class={css({
              display: 'grid',
              gap: '3',
              pt: '4',
              borderTop: '1px solid var(--line)',
              md: { gridTemplateColumns: '4.5rem minmax(0, 1fr)', alignItems: 'start' },
            })}
          >
            <span
              class={css({
                fontFamily: 'var(--font-display)',
                fontSize: 'clamp(1.45rem, 2vw, 1.8rem)',
                fontWeight: '600',
                letterSpacing: '-0.04em',
                color: 'var(--ink)',
              })}
            >
              {`0${index + 1}`}
            </span>
            <p class={css({ margin: '0', fontSize: '1.05rem', lineHeight: '1.65', color: 'var(--ink-muted)' })}>{item}</p>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Layout>
