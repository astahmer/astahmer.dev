---
import Layout from '@/layouts/layout.astro'
import SocialLinks from '@/components/social-links'
import { getCollection } from 'astro:content'
import { css } from '#/styled-system/css'
import { presentation } from '@/data/presentation'
import { projects } from '@/data/projects'
import { formatDate } from '@/utils/format-date'
import { readingTime } from '@/utils/reading-time'

const articles = (await getCollection('articles', (entry) => entry.data.isPublish)).toSorted(
  (first, second) => second.data.publishedAt.getTime() - first.data.publishedAt.getTime(),
)
---

<Layout title={presentation.name} description={presentation.intro}>
  <main
    class={css({
      display: 'grid',
      gap: '10',
      lg: { gridTemplateColumns: '14rem minmax(0, 1fr)', gap: '0', alignItems: 'start' },
    })}
  >
    <aside
      class={css({
        display: 'grid',
        gap: '5',
        lg: { position: 'sticky', top: '0', pt: '0', pr: '8', alignContent: 'start' },
      })}
    >
      <div class={css({ display: 'grid', gap: '2' })}>
        <p
          class={css({
            margin: '0',
            fontFamily: 'var(--font-display)',
            fontSize: '0.88rem',
            fontWeight: '560',
            color: 'var(--ink)',
          })}
        >
          Alexandre Stahmer
        </p>
        <p
          class={css({
            margin: '0',
            fontSize: '0.88rem',
            lineHeight: '1.6',
            color: 'var(--ink-soft)',
          })}
        >
          Freelance engineer. Type-safety, performance and developer tooling.
        </p>
      </div>
      <p
        class={css({
          margin: '0',
          fontSize: '0.82rem',
          lineHeight: '1.6',
          color: 'var(--ink-muted)',
        })}
      >
        {presentation.availability}
      </p>
      <SocialLinks />
    </aside>

    <div class={css({ display: 'grid', gap: '10', lg: { borderLeft: '1px solid var(--line)', pl: '8' } })}>
      <section>
        <h2
          class={css({
            margin: '0 0 1rem',
            fontFamily: 'var(--font-display)',
            fontSize: '0.68rem',
            fontWeight: '640',
            letterSpacing: '0.12em',
            textTransform: 'uppercase',
            color: 'var(--ink-soft)',
          })}
        >
          Writing
        </h2>
        {
          articles.slice(0, 6).map((article, i) => (
            <a
              href={`/posts/${article.id}`}
              class={css({
                display: 'grid',
                gridTemplateColumns: '5.5rem 1fr',
                gap: '3',
                py: '3',
                borderTop: '1px solid var(--line)',
                textDecoration: 'none',
                alignItems: 'baseline',
                transition: 'color 120ms ease',
                color: i === 0 ? 'var(--ink)' : 'var(--ink-muted)',
                _hover: { color: 'var(--ink)' },
              })}
            >
              <time
                datetime={article.data.publishedAt.toISOString()}
                class={css({
                  display: 'grid',
                  gap: '0.2rem',
                  fontFamily: 'var(--font-mono)',
                  fontSize: '0.72rem',
                  color: 'var(--ink-soft)',
                  flexShrink: '0',
                  pt: '0.15rem',
                })}
              >
                <span>{formatDate(article.data.publishedAt)}</span>
                <span class={css({ fontSize: '0.66rem', color: 'var(--ink-muted)' })}>
                  {readingTime(article.body ?? '')} min read
                </span>
              </time>
              <span class={css({ display: 'grid', gap: '0.2rem' })}>
                <span class={css({ lineHeight: '1.48', fontFamily: 'var(--font-display)', fontSize: '0.92rem', fontWeight: '520', color: 'var(--ink)', })}>{article.data.title}</span>
                {article.data.description && (
                  <span class={css({ fontSize: '0.82rem', lineHeight: '1.5', color: 'var(--ink-soft)' })}>
                    {article.data.description}
                  </span>
                )}
              </span>
            </a>
          ))
        }
        {
          articles.length > 6 && (
            <div class={css({ pt: '3', borderTop: '1px solid var(--line)' })}>
              <a
                href='/posts'
                class={css({
                  fontFamily: 'var(--font-display)',
                  fontSize: '0.78rem',
                  color: 'var(--ink-soft)',
                  textDecoration: 'none',
                  _hover: { color: 'var(--ink)' },
                })}
              >
                View all →
              </a>
            </div>
          )
        }
      </section>

      <section>
        <h2
          class={css({
            margin: '0 0 1rem',
            fontFamily: 'var(--font-display)',
            fontSize: '0.68rem',
            fontWeight: '640',
            letterSpacing: '0.12em',
            textTransform: 'uppercase',
            color: 'var(--ink-soft)',
          })}
        >
          Open source
        </h2>
        {
          projects.slice(0, 5).map((project) => (
            <a
              href={project.link}
              target='_blank'
              rel='noreferrer'
              class={css({
                display: 'grid',
                py: '3',
                borderTop: '1px solid var(--line)',
                textDecoration: 'none',
                color: 'var(--ink-muted)',
                transition: 'color 120ms ease',
                gap: '1',
                _hover: { color: 'var(--ink)' },
              })}
            >
              <span
                class={css({
                  fontFamily: 'var(--font-display)',
                  fontSize: '0.92rem',
                  fontWeight: '520',
                  color: 'var(--ink)',
                })}
              >
                {project.title}
              </span>
              <span class={css({ fontSize: '0.82rem', lineHeight: '1.5', color: 'var(--ink-soft)' })}>{project.description}</span>
            </a>
          ))
        }
      </section>
    </div>
  </main>
</Layout>
