---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/layout.astro'
import { css } from '#/styled-system/css'
import PostSection from '@/components/post-section'

const articles = (await getCollection('articles', (entry) => entry.data.isPublish)).toSorted(
  (first, second) => second.data.publishedAt.getTime() - first.data.publishedAt.getTime(),
)
---

<Layout title='Writing' description='Articles and notes by Alexandre Stahmer.'>
  <main class={css({ display: 'grid', gap: '8' })}>
    <section class={css({ display: 'grid', gap: '3', maxW: '42rem' })}>
      <p class='section-kicker'>Writing</p>
      <h1 class='section-heading'>Notes, articles, and the occasional well-earned tangent.</h1>
      <p class='section-copy'>
        Mostly frontend systems, design-tooling edges, product architecture, and whatever else survives the draft folder.
      </p>
    </section>
    <PostSection
      articles={articles}
      title={`All writing (${articles.length})`}
      intro='Everything published here, ordered from newest to oldest.'
    />
  </main>
</Layout>
