---
import { SEO, type Props as SEOProps } from 'astro-seo'
import { SITE_URL } from '@/data/config'
import { presentation } from '@/data/presentation'
import ColorModeScript from '@/components/color-mode-script.astro'

export interface Props extends Partial<SEOProps> {
  image?: string
  canonical?: string
  publishedTime?: string
  standardSiteDocumentUri?: string
}

const { title, description, noindex, openGraph: og, canonical, publishedTime, image, standardSiteDocumentUri } = Astro.props

const DEFAULT_TITLE_PAGE = 'Alexandre Stahmer'
const DEFAULT_URL_SITE = SITE_URL

const openGraph = {
  title: title || og?.basic?.title || DEFAULT_TITLE_PAGE,
  type: og?.basic?.type || 'website',
  image: String(image || og?.image?.url || '/opengraph-image.png'),
  alt: og?.image?.alt || 'Preview image for astahmer.dev',
  url: DEFAULT_URL_SITE,
  description: og?.optional?.description || presentation.title,
}
---

<head>
  <ColorModeScript />
  <SEO
    charset="UTF-8"
    title={title || DEFAULT_TITLE_PAGE}
    description={description || presentation.title}
    noindex={noindex || false}
    canonical={canonical}
    openGraph={{
      basic: { title: openGraph.title, type: openGraph.type, image: openGraph.image },
      image: { alt: openGraph.alt },
      optional: { description, locale: 'en_US', siteName: DEFAULT_TITLE_PAGE },
    }}
    twitter={{ creator: '@astahmer_dev' }}
    extend={{
      link: [
        { rel: 'icon', href: '/favicon.png' },
        { rel: 'sitemap', href: '/sitemap-index.xml' },
      ],
      meta: [
        { name: 'viewport', content: 'width=device-width, initial-scale=1' },
        { name: 'generator', content: Astro.generator },
        {
          name: 'twitter:image',
          content: openGraph.image,
        },
        { name: 'twitter:card', content: 'summary_large_image' },
        { name: 'twitter:title', content: openGraph.title },
        { name: 'twitter:description', content: openGraph.description },
        { name: 'twitter:site', content: '@astahmer_dev' },
      ],
    }}
  />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {standardSiteDocumentUri && <link rel="site.standard.document" href={standardSiteDocumentUri} />}
</head>
