---
---

<button type='button' id='color-mode-switch' class='theme-toggle' data-mode='light'>
  <span aria-hidden='true' class='theme-toggle__thumb'></span>
  <span class='theme-toggle__label theme-toggle__label--light'>Light</span>
  <span class='theme-toggle__label theme-toggle__label--dark'>Dark</span>
</button>

<script>
  import { type ColorMode, registerColorModeListener, setColorMode } from '@/utils/color-mode'

  const btn = document.getElementById('color-mode-switch') as HTMLButtonElement | null

  if (btn) {
    const button = btn

    const getActiveMode = (): Exclude<ColorMode, 'system'> =>
      document.documentElement.classList.contains('dark') ? 'dark' : 'light'

    registerColorModeListener()

    function toggleColorMode() {
      const currentMode = getActiveMode()
      const newMode = currentMode === 'dark' ? 'light' : 'dark'
      setColorMode(newMode)
      setButtonState(newMode)
    }

    function setButtonState(mode: ColorMode) {
      button.dataset.mode = mode === 'dark' ? 'dark' : 'light'
      button.setAttribute('aria-label', `Switch to ${mode === 'dark' ? 'light' : 'dark'} mode`)
    }

    button.addEventListener('click', toggleColorMode)
    setButtonState(getActiveMode())
  }
</script>
